@echo off
chcp 65001 >nul
setlocal
set "KOMARI_LAUNCHER_PATH=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $scriptPath=Join-Path $env:TEMP ('komari-bootstrap-'+[guid]::NewGuid().ToString('N')+'.ps1'); try { $content=Get-Content -LiteralPath $env:KOMARI_LAUNCHER_PATH -Raw -Encoding UTF8; $marker='# KOMARI_POWERSHELL_BEGIN'; $payload=$content.Substring($content.LastIndexOf($marker)+$marker.Length); [IO.File]::WriteAllText($scriptPath,$payload,[Text.UTF8Encoding]::new($true)); & $scriptPath; exit $LASTEXITCODE } catch { Write-Host $_ -ForegroundColor Red; Read-Host 'Press Enter to close'; exit 1 } finally { if (Test-Path -LiteralPath $scriptPath) { Remove-Item -LiteralPath $scriptPath -Force -ErrorAction SilentlyContinue } }"
exit /b %errorlevel%
# KOMARI_POWERSHELL_BEGIN
# Source for the standalone install-komari.cmd launcher. Requires Windows PowerShell 5.1.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$GitHubProxy = 'https://ghproxy.05160715.xyz'

function Get-InstallChoice {
    param([bool]$Exists)
    if (-not $Exists) { return 'install' }
    Write-Host '发现已有 Komari 目录或服务。' -ForegroundColor Yellow
    Write-Host '[1] 覆盖升级：备份旧程序，保留配置和原服务参数'
    Write-Host '[2] 取消安装（默认）'
    if ((Read-Host '请选择 1 或 2') -eq '1') { return 'overwrite' }
    return 'cancel'
}

function Read-AgentConnection {
    do {
        $endpoint = (Read-Host '请输入面板地址，例如 https://monitor.example.com').Trim()
        $uri = $null
        $valid = [Uri]::TryCreate($endpoint, [UriKind]::Absolute, [ref]$uri) -and
            $uri.Scheme -in @('http', 'https') -and -not [string]::IsNullOrEmpty($uri.Host)
        if (-not $valid) { Write-Host '地址必须是有效的 http:// 或 https:// 面板地址。' -ForegroundColor Yellow }
    } until ($valid)
    do {
        $secret = Read-Host '请输入面板生成的 Agent Token（输入不显示）' -AsSecureString
        $secretPointer = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secret)
        try { $token = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($secretPointer) }
        finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($secretPointer); $secret.Dispose() }
        if ([string]::IsNullOrWhiteSpace($token)) { Write-Host 'Token 不能为空。' -ForegroundColor Yellow }
    } until (-not [string]::IsNullOrWhiteSpace($token))
    return @('--endpoint', $endpoint, '--token', $token)
}

function Get-InstallerAsset {
    param($Release)
    if ($Release.draft -or $Release.prerelease -or -not $Release.tag_name) { throw '没有找到稳定发布版本。' }
    $assets = @($Release.assets | Where-Object { $_.name -eq 'install.ps1' })
    if ($assets.Count -ne 1) { throw '该版本没有唯一的 install.ps1 安装文件。' }
    $asset = $assets[0]
    $url = [Uri]$asset.browser_download_url
    if ($url.Scheme -ne 'https' -or $url.Host -ne 'github.com' -or
        -not $url.AbsolutePath.StartsWith('/htt050715/komari-agent/releases/download/')) {
        throw '安装文件的下载地址不属于 htt050715/komari-agent。'
    }
    if ($asset.digest -notmatch '^sha256:[a-fA-F0-9]{64}$') { throw '安装文件缺少有效的 SHA-256 校验值。' }
    return $asset
}

function Get-WithRetry {
    param([string]$Url, [string]$Destination, [string]$ExpectedDigest)
    $urls = @($Url)
    if ($GitHubProxy) { $urls = @(($GitHubProxy.TrimEnd('/') + '/' + $Url), $Url) }
    for ($attempt = 1; $attempt -le 3; $attempt++) {
        foreach ($sourceUrl in $urls) {
            try {
                if ($Destination) {
                    Invoke-WebRequest -Uri $sourceUrl -OutFile $Destination -UseBasicParsing -TimeoutSec 60
                    if ($ExpectedDigest -and $ExpectedDigest -ne ('sha256:' + (Get-FileHash -LiteralPath $Destination -Algorithm SHA256).Hash)) {
                        throw '下载文件 SHA-256 校验失败。'
                    }
                    return
                }
                $result = Invoke-RestMethod -Uri $sourceUrl -UseBasicParsing -TimeoutSec 30
                if (-not $result.tag_name) { throw '版本 API 返回了无效内容。' }
                return $result
            } catch {
                $lastError = $_
                if ($sourceUrl -ne $Url) { Write-Host '代理请求失败，正在尝试 GitHub 直连……' -ForegroundColor Yellow }
            }
        }
        if ($attempt -eq 3) { throw $lastError }
        Write-Host "下载失败，正在重试（$attempt/3）……" -ForegroundColor Yellow
        Start-Sleep -Seconds 2
    }
}

function Invoke-OneClickInstall {
    $isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
        [Security.Principal.WindowsBuiltinRole]::Administrator)
    if (-not $isAdmin) {
        Write-Host '安装需要管理员权限，请在弹出的窗口中确认。' -ForegroundColor Cyan
        # The path is generated by the CMD launcher. Quote it for paths containing spaces.
        $scriptArg = '"' + $PSCommandPath + '"'
        $hostExe = Join-Path $PSHOME 'powershell.exe'
        $elevated = Start-Process -FilePath $hostExe -Verb RunAs -Wait -PassThru -ArgumentList (
            '-NoProfile -ExecutionPolicy Bypass -File ' + $scriptArg)
        return $elevated.ExitCode
    }
    return Invoke-SelectedInstall
}

function Invoke-SelectedInstall {
    Write-Host 'Komari 一键安装 / 覆盖升级' -ForegroundColor Cyan
    Write-Host '仓库：htt050715/komari-agent；默认关闭开机登录通知。'
    $serviceName = 'komari-agent'
    $installDir = Join-Path $env:ProgramFiles 'Komari'
    $existingService = Get-Service -Name $serviceName -ErrorAction SilentlyContinue
    $exists = [bool]($existingService -or (Test-Path -LiteralPath $installDir))
    $choice = Get-InstallChoice -Exists $exists
    if ($choice -eq 'cancel') {
        Write-Host '已取消，未修改已有文件或服务。'
        Read-Host '按回车关闭窗口' | Out-Null
        return 0
    }

    $installerArgs = @('--install-service-name', $serviceName, '--install-existing', 'overwrite', '--install-ghproxy', $GitHubProxy)
    if ($existingService) {
        Write-Host '将沿用已有服务的安装目录、配置和启动参数。' -ForegroundColor Green
    } else {
        $installerArgs += Read-AgentConnection
    }

    $tempDir = Join-Path $env:TEMP ('komari-install-' + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $tempDir | Out-Null
    $installerPath = Join-Path $tempDir 'install.ps1'
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Write-Host '正在获取你的仓库的最新稳定版本……' -ForegroundColor Cyan
        $release = Get-WithRetry -Url 'https://api.github.com/repos/htt050715/komari-agent/releases/latest'
        $asset = Get-InstallerAsset -Release $release
        Get-WithRetry -Url $asset.browser_download_url -Destination $installerPath -ExpectedDigest $asset.digest
        $actual = (Get-FileHash -LiteralPath $installerPath -Algorithm SHA256).Hash
        if ($asset.digest -ne ('sha256:' + $actual)) { throw '安装文件校验失败，已停止安装。' }
        $installerArgs += @('--install-version', [string]$release.tag_name)
        # Invoke in the elevated PowerShell process so the Token is not placed on a new process command line.
        $global:LASTEXITCODE = 0
        & $installerPath @installerArgs
        $resultCode = $LASTEXITCODE
        if ($resultCode -ne 0) { throw "安装器返回错误代码 $resultCode。" }
        Write-Host '安装完成，请打开面板确认设备在线。' -ForegroundColor Green
        Read-Host '按回车关闭窗口' | Out-Null
        return 0
    } finally {
        $installerArgs = $null
        if (Test-Path -LiteralPath $installerPath) { Remove-Item -LiteralPath $installerPath -Force -ErrorAction SilentlyContinue }
        Remove-Item -LiteralPath $tempDir -ErrorAction SilentlyContinue
    }
}

try { exit (Invoke-OneClickInstall) } catch {
    Write-Host "安装失败：$_" -ForegroundColor Red
    Write-Host '如果取消了管理员权限申请，请重新运行脚本；网络失败时也可以重新运行。'
    Read-Host '按回车关闭窗口' | Out-Null
    exit 1
}
